APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# How the gateway validates a token, and so what iam issues: signature (a JWT, checked with iam's public key)
# or issuer (an opaque token, iam is asked on every request). The same for iam and the gateway.
AUTH_TOKEN_VALIDATION_STRATEGY=signature
AUTH_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=0
# Empty: read from {AUTH_JWT_KEYS_PATH}/jwt-{public,private}.key, written by `php artisan auth:jwt-keys`.
AUTH_JWT_KEYS_PATH=
AUTH_JWT_PUBLIC_KEY=
AUTH_JWT_PRIVATE_KEY=
# The gateway signs X-Identity with it, every module checks it: the same everywhere.
AUTH_GATEWAY_SECRET=
# The Redis connection iam writes the users the gateway reads to (`gateway`); empty writes nothing.
AUTH_GATEWAY_USERS_CONNECTION=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# the same in every service: CACHE_PREFIX=cache: and REDIS_PREFIX=database: by default
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DISTRIBUTABLE_STREAM_DRIVER=redis
DISTRIBUTABLE_STREAM_GUARD=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
